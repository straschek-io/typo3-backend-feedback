{
    "name": "straschek-io/typo3-backend-feedback",
    "description": "Backend toolbar button for editors to send feedback such as a missing permission, with the current view attached, by mail",
    "license": "GPL-2.0-or-later",
    "type": "typo3-cms-extension",
    "authors": [
        {
            "name": "Michael Straschek",
            "email": "hallo@straschek.io"
        }
    ],
    "support": {
        "email": "hallo@straschek.io",
        "issues": "https://github.com/straschek-io/typo3-backend-feedback/issues",
        "source": "https://github.com/straschek-io/typo3-backend-feedback"
    },
    "require": {
        "php": "^8.2",
        "typo3/cms-backend": "^13.4",
        "typo3/cms-core": "^13.4",
        "typo3/cms-fluid": "^13.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "typo3/coding-standards": "^0.9"
    },
    "autoload": {
        "psr-4": {
            "StraschekIo\\BackendFeedback\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StraschekIo\\BackendFeedback\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "sort-packages": true
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "backend_feedback"
        }
    },
    "scripts": {
        "ci": [
            "@ci:composer:validate",
            "@ci:yaml:lint",
            "@ci:php:cs",
            "@ci:php:stan",
            "@ci:php:unit"
        ],
        "ci:composer:validate": "@composer validate --strict",
        "ci:php:cs": "php-cs-fixer fix --dry-run --diff",
        "ci:php:stan": "phpstan analyse --no-progress",
        "ci:php:unit": "phpunit",
        "ci:yaml:lint": "yaml-lint Configuration",
        "fix:php:cs": "php-cs-fixer fix"
    }
}
